# ─────────────────────────────────────────────────────────────
#  AI Feedback Analyzer — Configuración del backend
#  Copia este archivo a `.env` y rellena los valores.
#     cp .env.example .env
#  NUNCA subas tu archivo .env al repositorio.
# ─────────────────────────────────────────────────────────────

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto del servidor Express
PORT=3000

# Cadena de conexión de MongoDB.
# Local:  mongodb://localhost:27017/feedback_analyzer
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/feedback_analyzer
MONGO_URI=mongodb://localhost:27017/feedback_analyzer

# Clave de la API de OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-reemplaza-esto

# Secreto para firmar los JSON Web Tokens. Mínimo 32 caracteres.
# Genera uno único con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si este valor se filtra, cualquiera puede falsificar sesiones: trátalo como una contraseña.
JWT_SECRET=genera-tu-propio-secreto-de-al-menos-32-caracteres

# Duración de la sesión (formato de la librería `ms`: 30d, 12h, 15m...)
JWT_EXPIRES_IN=30d

# Orígenes permitidos por CORS, separados por coma si hay varios.
CORS_ORIGIN=http://localhost:5173

# Número de proxies delante de la app. 0 en local.
# Si despliegas en Render, Railway, Fly o detrás de nginx, normalmente 1.
# Con 0 detrás de un proxy, TODOS los usuarios comparten el mismo límite de
# peticiones. Con un valor mayor del real, cualquiera puede falsear su IP.
TRUST_PROXY=0

# ── Cuotas por cuenta ──
# Protegen tu factura de OpenAI y el tamaño de la base de datos. A diferencia
# del límite por IP, no se pueden esquivar rotando de IP.

# Máximo de análisis por cuenta y día.
MAX_ANALISIS_DIARIOS=200

# Máximo de reseñas almacenadas por cuenta.
MAX_RESENAS_POR_CUENTA=5000

# Máximo de reseñas por petición en la carga masiva (tope absoluto: 200).
MAX_LOTE=50
